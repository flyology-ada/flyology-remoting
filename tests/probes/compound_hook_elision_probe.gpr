with "../../flyology_remoting.gpr";

project Compound_Hook_Elision_Probe is

   for Source_Dirs use (".");
   for Object_Dir use external ("FLYOLOGY_REMOTING_HOOK_PROBE_OBJECT_DIR", "../../obj/hook-probe");
   for Create_Missing_Dirs use "True";
   for Main use ("compound_hook_elision_probe.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatwJ", "-gnatyM110");
   end Compiler;

end Compound_Hook_Elision_Probe;
