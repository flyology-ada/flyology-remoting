with "../flyology_remoting.gpr";

project Flyology_Remoting_Tests is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/tests";
   for Exec_Dir use "../bin/tests";
   for Create_Missing_Dirs use "True";
   for Main use ("compile_smoke.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatyM110");
   end Compiler;

end Flyology_Remoting_Tests;
